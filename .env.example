# ---- chain (read-only values; enough for record --dry-run, verify, status) --
# setup.sh replaces this with the hackathon RPC URL from the mentors.
PEAQOS_RPC_URL=https://quicknode.peaq.xyz
EVENT_REGISTRY_ADDRESS=0xA1e7F1d7B24dAb55Dc92491e6d9B89F6E925Ad1e
PEAQOS_NETWORK=mainnet
TOKENOMICS_DEPLOYMENT_ID=peaq-mainnet

# ---- written by `peaqos init` (scripts/setup.sh): needed only for --live ---
# PEAQOS_PRIVATE_KEY=
# PEAQOS_MCR_API_URL=
# IDENTITY_REGISTRY_ADDRESS=
# IDENTITY_STAKING_ADDRESS=
# MACHINE_NFT_ADDRESS=
# DID_REGISTRY_ADDRESS=
# BATCH_PRECOMPILE_ADDRESS=

# ---- kit settings ---------------------------------------------------------
# Your team's machine ID: setup.sh writes it.
KIT_MACHINE_ID=
# The real A0509 in Munich (pendant module): for `armkit status --arm`.
KIT_ARM_MACHINE_ID=15083021071335353053994705927780059101231441765380432097794409355707727094755

# Where the arm's joint state comes from: synthetic | csv | ros2
KIT_JOINT_SOURCE=synthetic
KIT_CSV_PATH=data/sample_joint_log.csv
KIT_ROS2_TOPIC=/dsr01/joint_states

# Where the local motion log is kept (the full data; only hashes go on chain).
KIT_LOG_DIR=./motion-log

# Motion segmentation (rad/s and seconds).
KIT_VELOCITY_THRESHOLD=0.02
KIT_MIN_SEGMENT_SECONDS=0.3
KIT_SETTLE_SECONDS=0.4
KIT_MAX_SEGMENT_SECONDS=20

# 0 = self-reported. The kit only submits 0 (see docs/APP.md).
KIT_TRUST_LEVEL=0
